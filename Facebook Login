import { test} from '@playwright/test';

test('has title', async ({ page }) => {
  await page.goto('https://facebook.com');

  
//Storing the site name (Why? --- Just for fun)
  const SiteName = await page.title();
//Displaying the site name
  console.log("Name of the Site:",(SiteName))

//Input the username
  const Username =   await page.getByRole('textbox', { name: 'Email address or mobile number' });
  Username.click();
  Username.fill("username");

//Input the password
  const Password = await page.getByRole('textbox', { name: 'Password' });
  Password.click();
  Password.fill("Password");

//Click on the Login Button
  const Login = await page.getByRole('button', { name: 'Log in' });
  Login.click();

    await page.pause();

});
